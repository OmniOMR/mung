digraph DAG {
  rankdir=LR;
  node [shape=circle, style=filled, fillcolor=white, fontname="Helvetica"];

  /* nodes: id [label="id:class"] */
  1 [label="1:A"];
  2 [label="2:B"];
  3 [label="3:C"];
  4 [label="4:A"];
  5 [label="5:B"];
  6 [label="6:C"];
  7 [label="7:A"];
  8 [label="8:B"];
  9 [label="9:C"];
  10 [label="10:A"];
  11 [label="11:B"];
  12 [label="12:C"];

  /* edges */
  1 -> 2;
  1 -> 3;
  2 -> 4;
  2 -> 5;
  3 -> 6;
  3 -> 7;
  4 -> 8;
  5 -> 8;
  5 -> 9;
  6 -> 9;
  7 -> 10;
  8 -> 11;
  9 -> 11;
  9 -> 12;
}
